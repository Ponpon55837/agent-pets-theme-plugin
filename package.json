{
  "name": "agent-pets-theme-plugin",
  "version": "1.1.0",
  "private": true,
  "description": "Panel themes (colours, fonts, backgrounds; light and dark) for Agent Pets 1.12.0+, packaged as a workerless plugin.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "validate": "node scripts/validate.ts",
    "build": "node scripts/build.ts",
    "sign": "node scripts/sign.ts",
    "verify": "node scripts/verify.ts",
    "catalog-entry": "node scripts/catalog-entry.ts",
    "catalog-merge": "node scripts/catalog-merge.ts",
    "release-check": "node scripts/release-check.ts",
    "sync-rules": "node scripts/sync-rules.ts",
    "keygen": "node scripts/keygen.ts",
    "assets": "node scripts/assets/generate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import ./tests/setup.ts --test \"tests/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "7.0.2"
  }
}
