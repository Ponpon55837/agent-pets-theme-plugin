{
  "name": "agent-pets-theme-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "Panel themes (colours, fonts, backgrounds; light and dark) for Agent Pets 1.12.0+, packaged as a workerless plugin.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/build.mjs",
    "sign": "node scripts/sign.mjs",
    "verify": "node scripts/verify.mjs",
    "catalog-entry": "node scripts/catalog-entry.mjs",
    "keygen": "node scripts/keygen.mjs",
    "assets": "node scripts/assets/generate.mjs",
    "test": "node --test \"tests/*.test.mjs\""
  }
}
