{
  // Type checking only: Node runs the .ts files directly with its built-in type
  // stripping, so every file must use erasable syntax (no enums, namespaces or
  // parameter properties) and import siblings by their .ts name. Bundler
  // resolution matches the app, whose vendored type modules use extensionless
  // type imports.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "skipLibCheck": true
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts"]
}
